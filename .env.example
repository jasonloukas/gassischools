# Same Supabase project as the Gassi Schools OS.
NEXT_PUBLIC_SUPABASE_URL=

# Server-only. Never expose to the client, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only, not sensitive (safe to expose), used ONLY to call
# Supabase Auth's password sign-in for staff — never for data queries.
SUPABASE_ANON_KEY=

# Server-only. Random long string used to sign session cookies (jose/HS256).
# Generate with: openssl rand -base64 48
SESSION_SECRET=
